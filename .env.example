# Frontend environment. Copy to .env to override.
#   cp .env.example .env

# Base URL for API calls.
#
# Leave empty (the default) to call /api/* on the app's own origin, which the
# Vite dev proxy forwards to http://127.0.0.1:8000. Set it only when the API
# lives on a different origin; that origin must then be listed in the backend's
# DJANGO_CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=
