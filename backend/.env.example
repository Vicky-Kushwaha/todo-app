# Example environment. Copy to .env and fill in real values.
#   cp .env.example .env
# .env is git-ignored and must never be committed.

# Debug mode. Must be false in production.
DJANGO_DEBUG=true

# Required when DJANGO_DEBUG is false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated. Keep localhost/127.0.0.1 for local development.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to call the API from a browser (the Vite dev server).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite file path. Defaults to <project>/db.sqlite3.
DJANGO_DB_PATH=

# Log level for the todos loggers.
DJANGO_LOG_LEVEL=INFO

# HTTPS hardening. Leave false for local http development; set true behind TLS.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
